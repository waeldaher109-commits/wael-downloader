[app]
title = Wael Downloader
package.name = waeldownloader
package.domain = org.wael
source.include_exts = py,png,jpg,txt,ico,kv
version = 1.0
requirements = python3,kivy,yt_dlp,requests,urllib3,certifi,charset-normalizer,idna,pillow
orientation = portrait
fullscreen = 0
android.permissions = INTERNET, WRITE_EXTERNAL_STORAGE, READ_EXTERNAL_STORAGE
